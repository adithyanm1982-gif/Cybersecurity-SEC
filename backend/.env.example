# ============================================================
#  BACKEND ENVIRONMENT VARIABLES
#  Copy this file to ".env" for local use.
#  On Render: add the same names under  Environment  (never commit real values).
# ============================================================

# --- Google sign-in / sign-up (REQUIRED: this is the only login) --
# OAuth "Web application" client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# --- Database ---------------------------------------------------
# Postgres connection string. On Render it is filled in automatically by render.yaml.
# Example: postgresql://user:password@host:5432/dbname
# Leave EMPTY for local testing: a local SQLite file is used instead.
# (SQLite is erased on every Render deploy, so use Postgres in production.)
DATABASE_URL=

# --- Security ---------------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Owner / admins -----------------------------------------------
# Google e-mail addresses (comma separated, maximum 8) that may:
#   - download the CSV file of submitted forms
#   - upload / delete photos in the EVENTS page
# Everyone else who signs in is a normal user.
ADMIN_EMAILS=

# --- CORS ---------------------------------------------------------
# URL(s) of the deployed website, comma separated, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# --- Uploads ------------------------------------------------------
MAX_UPLOAD_MB=5
