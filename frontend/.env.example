# ============================================================
#  FRONTEND ENVIRONMENT VARIABLES
#  Local: copy this file to ".env"
#  Render (Static Site): add the same names under Environment, then redeploy.
#  NOTE: these values end up inside the public JavaScript, so only put
#  PUBLIC values here. Never put SECRET_KEY or database passwords here.
# ============================================================

# URL of the deployed backend, no trailing slash.
# Local example: http://localhost:8000      Render example: https://your-api.onrender.com
VITE_API_URL=

# Google OAuth "Web application" client ID (the SAME one as the backend GOOGLE_CLIENT_ID).
# REQUIRED: Google is the only way to sign in or sign up.
VITE_GOOGLE_CLIENT_ID=

# Optional: websocket URL of the local terminal helper (only for running on your own PC).
VITE_TERMINAL_URL=
